# profiles.yml.template
# Copy this to ~/.dbt/profiles.yml — no secrets needed, both targets use ADC.
# Dev:  gcloud auth application-default login
# Prod: Workload Identity Federation (configured by infra/setup_gcp.sh)

hdb_cash:
  target: dev
  outputs:

    dev:
      type: bigquery
      method: oauth                 # uses Application Default Credentials (gcloud auth application-default login)
      project: hdb-cash
      dataset: staging_dev          # writes to a dev-only dataset
      location: asia-southeast1
      timeout_seconds: 300
      retries: 1
      threads: 4

    prod:
      type: bigquery
      method: oauth                 # WIF configures ADC in GitHub Actions; works for local too
      project: hdb-cash
      dataset: staging              # writes to production staging dataset
      location: asia-southeast1
      timeout_seconds: 300
      retries: 1
      threads: 8
